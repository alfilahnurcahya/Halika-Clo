{
  "name": "halika-clo-backend",
  "version": "1.0.0",
  "description": "REST API Halika.Clo (Express + MySQL) — katalog, stok terpusat, chatbot, dashboard restock",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:init:seed": "node scripts/init-db.js --seed",
    "seed:admin": "node scripts/seed-admin.js",
    "import:csv": "node scripts/import-csv.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
