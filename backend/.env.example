# ==== Server ====
PORT=5000
NODE_ENV=development
# Origin frontend yang boleh mengakses API (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# ==== Database MySQL ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=halika_clo
# Isi "true" jika provider database cloud mewajibkan SSL (Aiven, TiDB Cloud, dll.)
DB_SSL=false

# ==== Autentikasi admin ====
# Buat string acak panjang, mis: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=8h
# Dipakai oleh `npm run seed:admin` untuk membuat akun owner (jangan commit nilai asli)
ADMIN_NAME=Owner Halika
ADMIN_EMAIL=owner@halika.local
ADMIN_PASSWORD=

# ==== Layanan model intent (tim Gen AI) ====
# Lokal mock: http://localhost:8000
ML_API_URL=http://localhost:8000
ML_API_TIMEOUT_MS=5000
# Di bawah nilai ini chatbot meminta pelanggan memperjelas pertanyaan
ML_MIN_CONFIDENCE=0.5

# ==== LLM proprietary (fitur generatif tambahan, opsional) ====
# Kosongkan untuk menonaktifkan -> jawaban memakai template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_MS=6000

# ==== Dashboard ====
LOW_STOCK_THRESHOLD=3
